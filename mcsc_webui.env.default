MCSC_WEB_HOST=127.0.0.1 # YOUR HOSTNAME
MCSC_WEB_PORT=11110 # YOUR PORT
MCSC_WEB_ORIGIN=http://127.0.0.1:11110 # YOUR ORIGIN
MCSC_TRUST_PROXY=false
MCSC_COOKIE_SECURE=false
# Optional direct TLS: set both variables to enable HTTPS in the WebUI itself.
MCSC_TLS_CERT_FILE=
MCSC_TLS_KEY_FILE=
MCSC_SESSION_DIR=./exclude/mcsc_sessions

# 32 digit SESSION SECRET
MCSC_SESSION_SECRET=__MCSC_SESSION_SECRET_HERE__

# ADMIN / PASSWORD
MCSC_ADMIN_USERNAME=mcsc-admin
MCSC_ADMIN_PASSWORD_HASH=
